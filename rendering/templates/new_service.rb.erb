class Provider::<%= provider_class_name %>Service < BaseService
  BASE_URL = ENV.fetch('<%= provider_name.upcase %>_BASE_URL', '<%= default_base_url %>')

  STATUS_MAP = {
    <%- status_mapping.each do |provider_status, internal_status| -%>
    '<%= provider_status %>' => '<%= internal_status %>',
    <%- end -%>
  }.freeze

  ERROR_MAP = {
    <%- error_mapping.each do |http_code, internal_error| -%>
    <%= http_code %> => '<%= internal_error %>',
    <%- end -%>
  }.freeze

  <%= methods_code %>
end