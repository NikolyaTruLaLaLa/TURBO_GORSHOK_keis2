<%- 
  # Принимает переменные:
  # endpoint_path: строка с путём, например "/payouts/{payout_id}"
  # param_name: имя параметра в пути, например "payout_id"
-%>
  public

  def fetch_status(operation)
    response = client.get("\#{BASE_URL}<%= endpoint_path.gsub(/\{#{param_name}\}/, "\#{operation.provider_operation_id}") %>", headers: auth_headers)

    unless response.status.between?(200, 299)
      error_key = ERROR_MAP[response.status] || 'unknown_error'
      return failure(error_key, "provider.http_error_#{response.status}")
    end

    map_status(response.body['status'])
  end

  private

  def map_status(provider_status)
    STATUS_MAP[provider_status] || 'unknown'
  end